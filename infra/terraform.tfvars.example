# The committed template. `terraform.tfvars` itself is gitignored, for the same reason `.env`
# is: it is where the filled-in credentials go.
#
# **Prefer the environment over this file.** Every variable below can be supplied as
# `TF_VAR_<name>`, which keeps the credential out of the working tree entirely:
#
#     export TF_VAR_tavily_api_key='...'       # PowerShell: $env:TF_VAR_tavily_api_key = '...'
#     export TF_VAR_llm_api_key='...'          # only when llm_provider = "openai"
#
# Copy to terraform.tfvars only if you would rather keep them in a file, and delete it after the
# teardown.
#
# **There is no db_password**, and that is Block B rather than an omission: RDS generates its own
# master password into a Secrets Manager secret it owns, so no password passes through Terraform
# and none lands in `terraform.tfstate` (docs/adr/0020-*.md decision 1).

# --- Required: no default exists for any of these -------------------------------------------

# The image tag all three task definitions run. A commit SHA, never `latest`
# (guidelines section 19): rollback is redeploying the previous task definition, and `latest`
# cannot name one.
image_tag = "REPLACE-WITH-COMMIT-SHA"

# The worker's search credential. Required whichever model provider answers.
tavily_api_key = "REPLACE-ME"

# --- The model provider: Bedrock by default, and the two sets are alternatives ----------------
#
# **Under the default there is nothing to fill in and no credential at all.** The worker calls
# Amazon Bedrock's Converse API against Amazon Nova, and the worker task role's
# `bedrock:InvokeModel` is the whole of the authentication - no key here, none in Secrets
# Manager, and none in the task definition (docs/adr/0022-*.md).
#
# **Verify the model id against your account and Region before the first apply.** In-Region
# availability of a foundation model is an account fact no Terraform configuration can assert;
# docs/deployment.md carries the one `aws bedrock list-inference-profiles` command that answers
# it, and a wrong value is an error on the first job rather than a failed apply.
#
# llm_provider     = "bedrock"
# bedrock_model_id = "apac.amazon.nova-pro-v1:0"
# bedrock_region   = ""            # empty means var.region

# The Regions a cross-region inference profile may route to, so the worker's IAM policy can name
# the foundation model in each of them. **Leaving this empty grants the model in this Region
# only**, which is right for a plain foundation model id and wrong for a profile that routes
# elsewhere - the symptom is an AccessDeniedException on some jobs and not others. Read the
# profile's own destination list with the `get-inference-profile` command in
# docs/deployment.md.
#
# bedrock_inference_profile_regions = ["ap-south-1", "ap-northeast-1", "ap-southeast-1"]

# --- The OpenAI-compatible alternative --------------------------------------------------------
#
# **Only when `llm_provider = "openai"`, and then all three are required** - the validations in
# variables.tf refuse an apply that sets the provider and forgets one. Setting them while the
# provider is `bedrock` does nothing: the worker receives no LLM variable at all, and no LLM
# secret is created. They are alternatives, never simultaneous requirements.
#
# llm_provider   = "openai"
# llm_base_url   = "https://REPLACE-ME/v1"
# llm_model      = "REPLACE-ME"
# llm_api_key    = "REPLACE-ME"
# llm_fast_model = ""      # empty falls back to llm_model, exactly as config.py does

# --- Optional: shown with their defaults -----------------------------------------------------

# region      = "ap-south-1"
# name_prefix = "competitive-research"

# How a caller proves who they are. `cognito` is the default and creates the user pool, its app
# client and the two role groups; the API verifies an access token against the pool's published
# signing keys (docs/adr/0020-*.md decision 2). Set `api_key` to keep the Phase 2 hashed key
# table instead - and then `auth_keys` below becomes required.
# auth_mode = "cognito"

# Only read when auth_mode is "api_key". The sha256 of each API key mapped to its user_id and
# role (guidelines section 16). **Generate throwaway keys for this deployment** - the two
# development keys published in .env.example must never be used here.
#
#     python -c "import hashlib,secrets; k=secrets.token_urlsafe(32); print(k, hashlib.sha256(k.encode()).hexdigest())"
#
# auth_keys = "{\"REPLACE-WITH-SHA256\":{\"user_id\":\"11111111-1111-4111-8111-111111111111\",\"role\":\"reviewer\"}}"

# An EXISTING, already-validated ACM certificate in this region. Set it and the load balancer
# gains an HTTPS listener while port 80 redirects to it. Left empty, the deployment speaks plain
# HTTP and **every bearer token travels in clear text** - nothing here creates a certificate,
# because a public one cannot be issued without a domain this repository does not own.
# certificate_arn = "arn:aws:acm:ap-south-1:REPLACE:certificate/REPLACE"

# Narrow this to your own address whenever the demo link is not being shared.
# allowed_ingress_cidrs = ["203.0.113.4/32"]

# --- The worker's four runtime bounds --------------------------------------------------------
#
# **The defaults below are what this deployment runs, and they are not config.py's.** config.py
# keeps 60 / 2 / 24 / 1200 for local work; the deployed worker gets the values both published
# n=20 baselines were measured at. Uncomment one to move it - most usefully
# `llm_main_timeout_s`, which is the number to lower for a fast endpoint and the number a slow
# one fails on. Nothing else in the deployment reads them: the API, the migration and the ops
# task run no graph node.
#
# llm_main_timeout_s  = 180    # request timeout for every main-tier agent call, seconds
# max_revisions       = 3      # automatic reflection cycles after the first report
# max_supervisor_hops = 30     # routing loop guard; must rise with max_revisions
# max_job_runtime     = 1800   # no-new-node deadline for ONE worker invocation, seconds

# api_desired_count    = 1
# worker_desired_count = 1

# db_instance_class = "db.t4g.micro"
# redis_node_type   = "cache.t4g.micro"

# log_retention_days = 1

# Both default to true because this environment is temporary. Set them false for anything whose
# data outlives the demo - and read what they cost in docs/deployment.md first.
# rds_skip_final_snapshot = true
# s3_force_destroy        = true
