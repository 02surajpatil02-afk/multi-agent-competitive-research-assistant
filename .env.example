# Environment variables, as defined in CLAUDE.md.
# Copy to .env for local use. Never commit a filled-in copy: this file exists so that
# secrets stay out of the repository (global CLAUDE.md §8).

# --- LLM: one OpenAI-compatible client, no provider classes -------------------
# NIM in development, the production endpoint in production. Swapping a model is a
# config change plus scripts/check_model.py plus an eval run - never a code change.
#
# WORKER ONLY, since docs/adr/0012-*.md. The API process starts, serves every route and
# passes its health check with none of the four below set, and with no TAVILY_API_KEY - it
# writes a row and enqueues a pointer, and never calls a model or fetches a page. The
# processes that do assume an LLM refuse to start without them instead: `python -m worker`,
# scripts/check_model.py, and scripts/measure_jobs.py.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=
# Cheap model for Supervisor routing and reflection scoring only.
# Falls back to LLM_MODEL when unset.
LLM_FAST_MODEL=
LLM_API_KEY=
# Shared client-side rate limit. The NIM free tier allows roughly 40 requests/minute.
LLM_RPM_LIMIT=40
# How long one main-model request may take. engineering-guidelines.md §17 sets 60s and that
# is the default; raise it only where the endpoint is slow. The NIM development tier
# generates at roughly 15-20 output tokens/second, which turns 60s into a cap of about a
# thousand output tokens - under a full report, so development uses 120. The fast tier is
# fixed at 30s: its callers receive a handful of tokens.
LLM_MAIN_TIMEOUT_S=60

# --- Web search --------------------------------------------------------------
TAVILY_API_KEY=

# --- Data stores --------------------------------------------------------------
# The ordinary libpq connection string - postgresql://user:password@host:5432/research -
# which is what psql, RDS, and the checkpointer's own pool all take. The SQLAlchemy driver
# name is added in code (database/queries.py), so it does not belong here.
#
# Used by `alembic upgrade head`, by the Postgres checkpointer, and by the audit-trail
# writes (implementation steps 13-16). Nothing reaches for it on its own: a process that
# wants durability passes it in, so leaving it unset runs the graph exactly as Phase 1 did
# rather than pointing at a server that is not running.
DATABASE_URL=
# Short-term state, and **worker-required since Phase 3 stage 3** (step 21). It holds the two
# tool caches, the per-job URL set, and the shared LLM rate limiter - and the last of those is
# why the worker refuses to start when Redis does not answer: the limiter fails closed, so
# without it no LLM call can be made at all (engineering-guidelines.md §11, §17).
#
# The API reads it for one thing only: `/health` reports `checks.redis`, which is how a
# deployment finds out its workers cannot work.
REDIS_URL=redis://localhost:6379/0

# --- AWS: required from Phase 3 ----------------------------------------------
# The job queue. **Required by both the API and the worker** since Phase 3 stage 2: the API
# enqueues one pointer message per submitted job and per reviewer decision, and the worker
# is what receives them. It must be a FIFO queue with a redrive policy - the worker reads
# both at startup and refuses to run without them (docs/adr/0010-*.md decisions 4 and 8).
#
# Against the local Compose stack:
#   SQS_QUEUE_URL=http://localhost:4566/000000000000/research-jobs.fifo
SQS_QUEUE_URL=
S3_BUCKET=
AWS_REGION=ap-south-1
# Where the AWS APIs live when they are not AWS. Unset against real AWS; the LocalStack
# address locally. It is the only difference between the two, which is what makes the
# `integration`-marked tests worth running - the same client, the same calls, a different
# address. Credentials still have to be present for boto3 to sign a request; LocalStack
# ignores their values, so AWS_ACCESS_KEY_ID=test and AWS_SECRET_ACCESS_KEY=test will do.
#   AWS_ENDPOINT_URL=http://localhost:4566
AWS_ENDPOINT_URL=

# --- Observability -----------------------------------------------------------
LANGSMITH_TRACING=false
# Required when LANGSMITH_TRACING is true.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=competitive-research

# --- Limits: the loop guards and content caps --------------------------------
# Two automatic improvement cycles, so at most three report-producing passes.
MAX_REVISIONS=2
# Routing oscillation guard. 20 is the automatic workflow's derived maximum (5 subtopics
# + 2 revisions, engineering-guidelines.md §5). A reviewer edit costs +1 legitimate hop, so
# bounding edits at 3 (docs/adr/0006-*.md, accepted) puts the ceiling at 23 and 24 stays
# correct as the ceiling plus one - it is NOT reduced to 20. Development overrides this to 30.
MAX_SUPERVISOR_HOPS=24
MAX_LLM_CALLS_PER_JOB=60
# How many times a reviewer may send one job back for an edit (docs/adr/0006-*.md). An edit
# is one Synthesizer pass over the evidence the job already has - never new research - and
# costs 3 calls and 1 hop, which is what puts the hop ceiling at 23.
MAX_REVIEWER_EDITS=3
# How long ONE WORKER INVOCATION may run, in seconds - not a job's lifetime
# (docs/adr/0010-*.md decision 7). A job that waits three days at the gate must not fail on
# resume, so the bound protects a delivery rather than a job. Enforced by the worker since
# Phase 3 stage 2, checked between nodes, and a job that exceeds it ends `failed` with
# `failure_reason="job_timeout"`.
#
# Raising it raises the queue's visibility timeout with it: that has to exceed
# MAX_JOB_RUNTIME + 3 x LLM_MAIN_TIMEOUT_S + 10, and `python -m worker` refuses to start
# against a queue where it does not. Put development slack in the queue, not here.
MAX_JOB_RUNTIME=1200
REFLECTION_PASS_THRESHOLD=3.5
MAX_FETCH_BYTES=2097152
MAX_PAGE_CHARS=24000
# How many of one subtopic's page extractions run at once (docs/adr/0002-*.md). Choosing and
# fetching sources stays sequential; only the extraction calls overlap. Refused outside 1-3 at
# startup rather than clamped. Set to 1 to restore strictly sequential extraction.
#
# RATE LIMIT: this bounds how many requests ONE JOB holds open at once. What bounds the
# deployment is the shared Redis limiter, built at step 21: LLM_RPM_LIMIT is now one window
# across every worker rather than a ceiling each process keeps to itself. One job measured
# 1.8 req/min against LLM_RPM_LIMIT=40; at 3 it is roughly 5.4 (engineering-guidelines.md §13).
RESEARCHER_CONCURRENCY=3

# --- Auth: required from Phase 2 ---------------------------------------------
# The API keys, HASHED, as JSON - never the keys themselves:
#   {"<sha256 hex of the key>": {"user_id": "<uuid>", "role": "reviewer"}}
# Two roles: `submitter` submits and reads its own jobs; `reviewer` may also decide at the
# gate. Print a digest with:
#   python -c "import hashlib,sys;print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" KEY
AUTH_KEYS=
# Secrets Manager id holding that same JSON. Read from Phase 5; unused before then.
AUTH_KEYS_SECRET_ID=

# --- Operations --------------------------------------------------------------
RETENTION_DAYS=365
APP_ENV=local
LOG_LEVEL=INFO

# --- Local infrastructure: NOT read by config.py ------------------------------
# Everything above is CLAUDE.md's environment table. The three below are read by
# `docker compose` and by the test suite, and never by the application.

# Docker Compose reads this file for its own interpolation. Set POSTGRES_PORT when 5432 is
# already taken on your machine - another project's container is enough - and follow it in
# DATABASE_URL and TEST_DATABASE_URL. REDIS_PORT and LOCALSTACK_PORT do the same for 6379
# and 4566.
POSTGRES_PORT=5432

# The database the `postgres`-marked tests run against:
#   docker compose up -d --wait
#   TEST_DATABASE_URL=postgresql://research:research@localhost:5432/research_test pytest -m postgres
# Every case drops its schema first, so the harness refuses a URL whose database name does
# not contain `test`. Compose creates research_test beside research for exactly this.
# It is read from the process environment, never from this file: pytest does not load .env,
# and that is deliberate - a URL sitting in a file must not turn the offline suite into one
# that opens sockets.
TEST_DATABASE_URL=

# The Redis database the `redis`-marked tests run against:
#   docker compose up -d --wait
#   TEST_REDIS_URL=redis://localhost:6379/15 pytest -m redis
# Every case flushes the database it is given, so the harness REFUSES database 0 - which is what
# REDIS_URL defaults to, and therefore the one an application run locally would be using. Read
# from the process environment, never from this file.
TEST_REDIS_URL=

# The LocalStack endpoint the `integration`-marked tests use, on exactly the same terms:
#   docker compose up -d --wait
#   SQS_ENDPOINT_URL=http://localhost:4566 pytest -m integration
# They read the queue Compose declares, create throwaway queues of their own, and drive the
# real worker against a real message. Unset, every one of them skips, which is what keeps
# plain `pytest` offline. Read from the process environment, never from this file.
SQS_ENDPOINT_URL=
